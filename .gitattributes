# Enforce checkout and checkin as-is with LF line endings across all platforms
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.dart text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.kt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.apk binary
*.dex binary
*.tar binary
*.gz binary
*.zip binary
*.ab binary
*.db binary
